# Local development only. docker compose uses the same user/database/password below.
POSTGRES_DB=stocksense
POSTGRES_USER=stocksense
POSTGRES_PASSWORD=stocksense_dev_password
DATABASE_URL=postgresql://stocksense:stocksense_dev_password@127.0.0.1:5432/stocksense
PG_POOL_MAX=10
SSI_TIMEOUT_MS=20000
MARKET_SYNC_LOOKBACK_DAYS=5
NEWS_TIMEOUT_MS=20000
# Set true only when the API is behind HTTPS.
COOKIE_SECURE=false
# Optional email notifications (verification is disabled until all SMTP values are set).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional Telegram bot channel. Configure Telegram webhook to /api/v1/notify/telegram/webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Required for Vietnamese PDF exports; point to a Unicode TrueType font (e.g. Noto Sans).
REPORT_FONT_PATH=apps/api/assets/fonts/NotoSans-Regular.ttf
# Public account recovery remains off until SMTP, app URL, and secret are configured.
PASSWORD_RESET_ENABLED=false
PUBLIC_APP_URL=
# Generate a random value with at least 32 characters; used to HMAC rate-limit identifiers.
AUTH_RATE_LIMIT_SECRET=
VITE_PASSWORD_RESET_ENABLED=false
# Must be explicitly enabled for the Analyst-only history CSV export.
HISTORY_CSV_EXPORT_ENABLED=false
VITE_HISTORY_CSV_EXPORT_ENABLED=false
# Used once by `npm run db:bootstrap-admin` to create the first admin on a database with no admin.
# Clear the password after running; the account must change it at first login.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
